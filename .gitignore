# Blue Berry — Godot 4.7 .gitignore (project root is repo root)
# Keep *.import for stable UIDs, ignore generated cache.

# Godot generated
.godot/
.mono/
export/
export_presets.cfg
data_*/
*.tmp
*.log
*.translation

# Godot 4: keep *.import (UIDs live in them). Imported pixel/shader
# cache lives under .godot/ and is already ignored above.

# Export binaries (if exporting outside export/)
*.pck
*.apk
*.aab

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*~

# VS Code — keep .vscode/launch.json & settings.json, ignore caches
.vscode/.ropeproject
.vscode/ipch/
.vscode/*.log
*.code-workspace

# OpenCode / Node
.opencode/node_modules/
.opencode/.opencode/
node_modules/
package-lock.json

# Backup / temp
*.bak
*.orig
~$*

# Build artifacts (if exporting)
build/
dist/
